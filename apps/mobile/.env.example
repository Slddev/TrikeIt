# URL of the web app that serves /api/auth (apps/web).
# Use your computer's LAN IP when testing on a device: localhost won't work there.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Standalone test builds (bun run build:apk) read the deployed web app from .env.production.local
# instead, and it must be https: release builds block plain HTTP.
# EXPO_PUBLIC_API_URL=https://your-app.vercel.app
