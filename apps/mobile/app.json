{
  "expo": {
    "name": "TrikeIt!",
    "slug": "trikeit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "trikeit",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFEA93"
      },
      "package": "com.trikeit.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFEA93",
          "imageWidth": 642
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrikeIt! uses your location to set your pick-up and drop-off points."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
