DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, "Web application").
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone sign-in SMS (production only; in development codes print to the server console).
SMSAPIPH_API_KEY=

# Demo mode: set to a 6-digit code to skip SMS entirely; every number signs in with it.
# Only for demo deployments, never the real production app.
DEMO_OTP_CODE=

# Comma-separated phone numbers (+639171234567) or emails that are always admins.
# Use it to create the first admin; manage every other role from /dashboard.
ADMIN_ACCOUNTS=
